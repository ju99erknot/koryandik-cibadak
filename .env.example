# ============================================================
# Koryandik Cibadak — Environment Variables
# ============================================================
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# JANGAN commit `.env.local` (sudah masuk .gitignore).

# --- WAJIB DI PRODUCTION ---------------------------------------------------
# Kunci HMAC untuk menandatangani cookie sesi. Jika tidak diisi saat
# production, aplikasi akan berhenti dengan error — ini disengaja: secret yang
# dapat ditebak berarti siapa pun bisa membuat token admin palsu.
#
# Buat nilai acak dengan:
#   openssl rand -hex 32
SERVER_SECRET=

# --- Kredensial admin ------------------------------------------------------
# Bila ADMIN_PASSWORD diisi, nilai inilah yang dipakai untuk login admin.
# Bila dikosongkan, sistem jatuh ke passcode bawaan di src/lib/authSecrets.ts
# (hanya untuk pengembangan — akan memunculkan peringatan di log production).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Supabase --------------------------------------------------------------
# Anon key AMAN diekspos ke browser HANYA jika RLS sudah diperketat.
# Jalankan supabase_migration_v14_security_rls.sql terlebih dahulu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key MELEWATI seluruh RLS. Hanya untuk kode server
# (API route / server action). Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
